---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const cdn = 'https://images.squarespace-cdn.com/content/v1/689393086346c340c753f950';
const amoeba = `${cdn}/18134adc-1d95-4a9d-8040-760c25e2eddd/Sept+22+2025.Amoeba+n+cyst.jpg?format=1500w`;
const scope = `${cdn}/03ce3214-9cd9-44dc-bbb6-a9f13e2adf9b/Scope+n+Monitor.jpg?format=1500w`;
const xavier = `${cdn}/d3641eb1-72ac-4d59-b446-5798575c3ac0/25-07-18-Xaviers+Legs.00_01_01_26.Still001.jpg?format=1500w`;
const sophia = `${cdn}/50411418-9279-4e75-923e-35d8914c8e79/Sophia+8.31.25.m.jpg?format=1500w`;

const reel = [
  { title: 'Amoeba & cyst', date: 'Sept 22', body: 'Two amoebae cruising through a drop of healthy garden soil, plus a resting cyst — survival mode for hard times.', image: amoeba, tag: 'Protozoa', free: true },
  { title: 'Under the scope', date: 'Aug 14', body: 'A walkthrough of the rig — the same setup we use every Sunday at the lab.', image: scope, tag: 'Behind the scenes', free: true },
  { title: 'Live fungal strands', date: 'Jul 18', body: 'Hyphae stretching through Xavier\'s premium compost. Watch how they connect aggregates.', image: xavier, tag: 'Fungi', free: false },
  { title: 'Bacterial blooms', date: 'Aug 31', body: 'A close-up at peak bacterial activity in a 5-day-old hot pile.', image: sophia, tag: 'Bacteria', free: false },
];
---
<BaseLayout title="Soil Cam — Soil Detective" description="A weekly look through the microscope. Free episodes on YouTube and Instagram, plus member-only deep dives.">
  <section class="relative overflow-hidden bg-soil-900 text-cream">
    <div class="absolute inset-0 opacity-30">
      <img src={amoeba} alt="" class="w-full h-full object-cover scale-110" loading="eager" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-soil-900/70 via-soil-900/85 to-soil-900"></div>
    <div class="container-x pt-24 pb-20 relative">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-500 mb-4">Soil Cam</p>
      <h1 class="text-5xl md:text-7xl text-cream max-w-4xl leading-[1.05]">
        A weekly look <span class="italic text-moss-300">through the scope.</span>
      </h1>
      <p class="mt-6 text-cream/85 max-w-prose leading-relaxed">
        Short videos of what's actually moving around in living soil. Free on YouTube and Instagram — member-only deep dives in The Soil Circle.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://www.youtube.com/" target="_blank" rel="noopener" class="btn-gold">Subscribe on YouTube</a>
        <a href="https://www.instagram.com/" target="_blank" rel="noopener" class="btn-outline-cream">Follow on Instagram</a>
      </div>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="flex items-baseline justify-between flex-wrap gap-3 mb-8">
      <h2 class="font-display text-3xl uppercase tracking-wide">Latest episodes</h2>
      <a href={link('/memberships')} class="text-[11px] uppercase tracking-[0.2em] text-plum-700 hover:text-plum-800 font-semibold">Unlock member-only episodes →</a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
      {reel.map((e) => (
        <article class="rounded-2xl bg-cream-dark/30 border border-soil/10 overflow-hidden flex flex-col">
          <div class="relative aspect-video overflow-hidden bg-soil-700">
            <img src={e.image} alt={e.title} class="w-full h-full object-cover" loading="lazy" />
            <span class="absolute top-3 left-3 text-[10px] uppercase tracking-[0.2em] bg-cream/90 text-soil px-2 py-1 rounded-full">{e.tag}</span>
            {!e.free && <span class="absolute top-3 right-3 text-[10px] uppercase tracking-[0.2em] bg-plum-700 text-cream px-2 py-1 rounded-full">Member</span>}
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="size-14 rounded-full bg-cream/90 text-soil flex items-center justify-center shadow-xl">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </span>
          </div>
          <div class="p-5 flex flex-col flex-1">
            <p class="text-[10px] uppercase tracking-[0.18em] text-soil/50">{e.date}</p>
            <h3 class="mt-1 font-display text-lg leading-snug">{e.title}</h3>
            <p class="mt-2 text-soil/75 text-sm leading-relaxed flex-1">{e.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-cream-dark/30 border-y border-soil/5">
    <div class="container-x py-20 grid md:grid-cols-3 gap-8 text-soil">
      <div>
        <p class="eyebrow-moss mb-2">Free episodes</p>
        <p class="font-display text-3xl">Public on YouTube & Instagram</p>
        <p class="mt-3 text-soil/75 text-sm">Short, scroll-friendly looks at what's living in real soil from real local growers.</p>
      </div>
      <div>
        <p class="eyebrow-moss mb-2">Member episodes</p>
        <p class="font-display text-3xl">Long-form deep dives</p>
        <p class="mt-3 text-soil/75 text-sm">10–20 minute breakdowns — identifying what you're seeing, what it means, and what to do about it.</p>
      </div>
      <div>
        <p class="eyebrow-moss mb-2">Featured samples</p>
        <p class="font-display text-3xl">Your soil, on the show</p>
        <p class="mt-3 text-soil/75 text-sm">Members can submit samples to be featured. We anonymize on request, or credit you fully — your call.</p>
      </div>
    </div>
  </section>

  <section class="container-x py-20">
    <div class="rounded-2xl bg-moss-700 text-cream p-10 md:p-14 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl text-cream">Want your soil on the next episode?</h2>
        <p class="mt-4 text-cream/85 max-w-prose">
          Soil Circle members can submit a sample to be featured on Soil Cam. Anonymized or credited — your call.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={link('/memberships')} class="btn-gold">Join The Soil Circle</a>
        <a href={link('/contact')} class="btn-outline-cream">Send a sample</a>
      </div>
    </div>
  </section>
</BaseLayout>
