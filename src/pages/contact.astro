---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;
---
<BaseLayout title="Book a Soil Check — Soil Detective" description="Schedule a free 20-minute consultation or book a Soil Health Check with Soil Detective in Olympia, WA.">
  <section class="container-x pt-20 pb-12">
    <p class="eyebrow mb-4">Book a Soil Check</p>
    <h1 class="text-5xl md:text-6xl max-w-3xl">
      A free 20-minute consultation, <span class="italic text-moss-700">then a clear next step.</span>
    </h1>
    <p class="mt-6 text-soil/75 max-w-prose leading-relaxed">
      Tell us a little about your growing reality — the patch of dirt, the questions you have, the things that aren't working. We'll use the call to focus on your priorities and goals for the season.
    </p>
  </section>

  <section class="container-x py-12 grid lg:grid-cols-[1.2fr_1fr] gap-10">
    <form class="rounded-2xl bg-cream-dark/30 border border-soil/10 p-8 md:p-10 space-y-5" action="mailto:soildetective@gmail.com" method="post" enctype="text/plain">
      <div class="grid sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-soil">Name</span>
          <input required type="text" name="name" class="mt-1 w-full rounded-md border border-soil/20 bg-cream px-3 py-2 text-soil focus:outline-none focus:border-moss-600" />
        </label>
        <label class="block">
          <span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-soil">Email</span>
          <input required type="email" name="email" class="mt-1 w-full rounded-md border border-soil/20 bg-cream px-3 py-2 text-soil focus:outline-none focus:border-moss-600" />
        </label>
      </div>
      <label class="block">
        <span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-soil">What are you growing (or trying to)?</span>
        <input type="text" name="growing" placeholder="Vegetable beds, market garden, orchard, houseplants…" class="mt-1 w-full rounded-md border border-soil/20 bg-cream px-3 py-2 text-soil placeholder-soil/40 focus:outline-none focus:border-moss-600" />
      </label>
      <label class="block">
        <span class="text-[11px] font-semibold uppercase tracking-[0.18em] text-soil">Tell us about your soil</span>
        <textarea name="message" rows="5" placeholder="What is working, what is not, and what you would like to figure out." class="mt-1 w-full rounded-md border border-soil/20 bg-cream px-3 py-2 text-soil placeholder-soil/40 focus:outline-none focus:border-moss-600"></textarea>
      </label>
      <fieldset class="space-y-2">
        <legend class="text-[11px] font-semibold uppercase tracking-[0.18em] text-soil">What are you most interested in?</legend>
        <div class="grid sm:grid-cols-2 gap-2 text-sm text-soil/85">
          <label class="flex items-center gap-2"><input type="checkbox" name="interest" value="analysis" class="rounded border-soil/30" /> Soil testing</label>
          <label class="flex items-center gap-2"><input type="checkbox" name="interest" value="compost" class="rounded border-soil/30" /> Living compost</label>
          <label class="flex items-center gap-2"><input type="checkbox" name="interest" value="workshops" class="rounded border-soil/30" /> Workshops</label>
          <label class="flex items-center gap-2"><input type="checkbox" name="interest" value="bulk" class="rounded border-soil/30" /> Bulk / farm orders</label>
        </div>
      </fieldset>
      <button type="submit" class="btn-primary w-full sm:w-auto">Send & Request Consultation</button>
      <p class="text-xs text-soil/50">We value and respect your privacy. Your details are used only to follow up about your inquiry.</p>
    </form>

    <aside class="space-y-6">
      <div class="rounded-2xl bg-cream border border-soil/10 p-8">
        <h2 class="text-xl uppercase tracking-wide">Reach Us Directly</h2>
        <ul class="mt-4 space-y-3 text-soil/80">
          <li><span class="text-[10px] uppercase tracking-[0.2em] text-soil/50 block">Email</span><a class="hover:text-moss-700" href="mailto:soildetective@gmail.com">soildetective@gmail.com</a></li>
          <li><span class="text-[10px] uppercase tracking-[0.2em] text-soil/50 block">Phone</span><a class="hover:text-moss-700" href="tel:+13602593637">(360) 259-3637</a></li>
          <li><span class="text-[10px] uppercase tracking-[0.2em] text-soil/50 block">Based in</span>Olympia, WA — serving Western Washington</li>
        </ul>
      </div>
      <div class="rounded-2xl bg-moss-700 text-cream p-8">
        <h2 class="text-xl text-cream uppercase tracking-wide">Newsletter</h2>
        <p class="mt-3 text-cream/85 text-sm">Upcoming events, workshop dates, and soil-health insights — sent occasionally, never sold.</p>
        <form class="mt-5 flex gap-2" action="mailto:soildetective@gmail.com" method="post" enctype="text/plain">
          <input required type="email" name="newsletter_email" placeholder="you@example.com" class="flex-1 rounded-md bg-cream/15 placeholder-cream/60 text-cream px-3 py-2 focus:outline-none focus:bg-cream/25 border border-cream/30" />
          <button class="btn-gold !px-4 !py-2 text-[11px]">Sign Up</button>
        </form>
      </div>
      <div class="rounded-2xl bg-cream border border-soil/10 p-8">
        <h2 class="text-xl uppercase tracking-wide">Have a Look Around</h2>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a class="text-plum-700 hover:text-plum-800 font-medium" href={link('/soil-101')}>Soil 101 →</a></li>
          <li><a class="text-plum-700 hover:text-plum-800 font-medium" href={link('/services')}>Soil Testing & Pricing →</a></li>
          <li><a class="text-plum-700 hover:text-plum-800 font-medium" href={link('/compost')}>Living Compost →</a></li>
          <li><a class="text-plum-700 hover:text-plum-800 font-medium" href={link('/learn')}>Workshops →</a></li>
        </ul>
      </div>
    </aside>
  </section>
</BaseLayout>
