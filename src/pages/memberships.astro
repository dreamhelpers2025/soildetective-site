---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const tiers = [
  {
    name: 'Free Community',
    price: 'Free',
    sub: 'Sign up · cancel anytime',
    badge: 'Start here',
    accent: 'bg-soil/10 text-soil',
    body: "Newsletter, public stories, Soil 101, and the free community tools. The doorway to everything else.",
    perks: ['Monthly newsletter', 'Soil 101 basics & blog', 'Recipe Builder + Pile Tracker (free tools)', '1 free sample upload to your dashboard', 'Event calendar'],
    cta: 'Join the List',
    href: '/contact',
    button: 'btn-outline-soil',
  },
  {
    name: 'The Soil Circle',
    price: '$15',
    sub: 'per month',
    badge: 'Most popular',
    accent: 'bg-moss-700/15 text-moss-700',
    body: "Where the real community lives. Live conversations, behind-the-scenes microscope work, and discounts that pay for the membership in one workshop.",
    perks: [
      'Everything in Free Community',
      'Monthly live Q&A with the Soil Detective',
      'Member-only Soil Cam videos & deep-dives',
      'Seasonal growing & composting guides',
      '15% off Soil Lab Sundays & compost',
      'Private member discussion space',
      'Early access to workshop seats',
      'Archived report dashboard (your soil over time)',
    ],
    cta: 'Join the Circle',
    href: '/contact',
    button: 'btn-moss',
  },
  {
    name: 'Premium Grower',
    price: '$59',
    sub: 'per month',
    badge: 'For serious growers',
    accent: 'bg-clay-500/15 text-clay-700',
    body: 'For gardeners, homesteaders, and market growers who want a real working relationship with their soil — and a soil scientist on call.',
    perks: [
      'Everything in The Soil Circle',
      'Quarterly Biological Soil Analysis included (4/year)',
      'Direct messaging with the Soil Detective',
      'Crop-specific recommendations',
      'Priority scheduling on Soil Lab Sundays',
      'Advanced interpretation of your reports',
      '25% off compost, workshops, and packages',
      'Pay-what-you-can option for low-income growers — just ask',
    ],
    cta: 'Talk to Us',
    href: '/contact',
    button: 'btn-clay',
  },
];

const pillars = [
  {
    title: 'Soil Intelligence Portal',
    body: 'Your samples, reports, microscope images, and recommendations in one place. Track how your soil changes season by season.',
    icon: 'dashboard',
  },
  {
    title: 'Community first',
    body: 'A private space to ask questions, share recipes, and meet growers in your region. No algorithm. No noise.',
    icon: 'community',
  },
  {
    title: 'Pay-it-forward',
    body: 'Memberships fund scholarship Soil Health Checks for neighbors who could not otherwise afford one. Visible support, real impact.',
    icon: 'heart',
  },
];
---
<BaseLayout title="Memberships — Soil Detective" description="A layered membership ecosystem — newsletter, The Soil Circle, and Premium Grower — that turns soil testing into an ongoing relationship.">
  <section class="container-x pt-20 pb-12">
    <p class="eyebrow mb-4">Memberships</p>
    <h1 class="text-5xl md:text-6xl max-w-3xl">
      Soil is slow work. <span class="italic text-moss-700">Steady relationships make it possible.</span>
    </h1>
    <p class="mt-6 text-soil/75 max-w-prose leading-relaxed">
      Pick the tier that matches how deep you want to go. Each tier builds on the one before it. Cancel anytime — and your free community access never expires.
    </p>
  </section>

  <section class="container-x pb-16">
    <div class="grid lg:grid-cols-3 gap-6 items-stretch">
      {tiers.map((t, i) => (
        <article class={`rounded-2xl border p-8 flex flex-col ${i === 1 ? 'bg-cream border-moss-600/40 shadow-[0_24px_48px_-24px_rgba(74,107,60,0.35)]' : 'bg-cream-dark/30 border-soil/10'}`}>
          <span class={`self-start text-[10px] uppercase tracking-[0.2em] px-2.5 py-1 rounded-full ${t.accent}`}>{t.badge}</span>
          <h2 class="mt-5 text-2xl uppercase tracking-wide">{t.name}</h2>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="font-display text-5xl text-soil">{t.price}</span>
            {t.price !== 'Free' && <span class="text-soil/60 text-sm">/ {t.sub}</span>}
          </div>
          {t.price === 'Free' && <span class="text-soil/60 text-sm">{t.sub}</span>}
          <p class="mt-4 text-soil/75 text-sm leading-relaxed">{t.body}</p>
          <ul class="mt-6 space-y-2.5 text-sm text-soil/85 flex-1">
            {t.perks.map((p) => (
              <li class="flex gap-2 items-start"><span class="mt-2 size-1.5 rounded-full bg-moss-600 shrink-0"></span><span>{p}</span></li>
            ))}
          </ul>
          <a href={link(t.href)} class={`${t.button} mt-7 w-full text-center`}>{t.cta}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-soil-700 text-cream">
    <div class="container-x py-20">
      <div class="max-w-2xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-500 mb-3">What you actually get</p>
        <h2 class="text-4xl md:text-5xl text-cream">More than a discount — an ecosystem.</h2>
      </div>
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {pillars.map((p) => (
          <div class="rounded-2xl bg-cream/5 border border-cream/10 p-7">
            <div class="size-12 rounded-full bg-moss-500/20 text-moss-300 flex items-center justify-center mb-4">
              {p.icon === 'dashboard' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="5" rx="1.5"/><rect x="13" y="10" width="8" height="11" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/></svg>}
              {p.icon === 'community' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.4"/><path d="M3 19c0-3 3-5 6-5s6 2 6 5M14 19c0-2 2-4 5-4s5 2 5 4"/></svg>}
              {p.icon === 'heart' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg>}
            </div>
            <h3 class="font-display text-xl text-cream">{p.title}</h3>
            <p class="mt-3 text-cream/75 text-sm leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x py-20">
    <div class="rounded-2xl bg-moss-100 p-10 md:p-14 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <p class="eyebrow-moss mb-3">Not sure where to start?</p>
        <h2 class="text-3xl md:text-4xl">Try a Soil Lab Sunday first.</h2>
        <p class="mt-4 text-soil/80 max-w-prose">
          The $45 entry session is the lowest-friction way in. If you decide to join afterward, the cost rolls into your first month of The Soil Circle.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={link('/services')} class="btn-moss">Book a Sunday</a>
        <a href={link('/contact')} class="btn-outline-soil">Talk to Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
