---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const tiers = [
  {
    name: 'Curious',
    price: '$10',
    sub: 'per month',
    body: "For the soil-curious. Newsletter, member-only soil tips, and 10% off Soil Lab Sundays.",
    perks: ['Member-only newsletter', '10% off Soil Lab Sundays', 'Early access to workshop dates'],
    badge: 'Start here',
  },
  {
    name: 'Grower',
    price: '$25',
    sub: 'per month',
    body: "For active gardeners and small farmers. Quarterly soil checks, member events, and a real conversation about your beds.",
    perks: ['Everything in Curious', '1 free Soil Lab Sunday per quarter', 'Quarterly member garden walk', '15% off compost orders'],
    badge: 'Most popular',
  },
  {
    name: 'Community',
    price: '$60',
    sub: 'per month',
    body: "Pay-it-forward tier. Funds scholarship spots for neighbors who couldn't otherwise afford a Soil Health Check.",
    perks: ['Everything in Grower', 'Sponsors 2 scholarship Soil Checks / month', 'Annual private workshop seat', 'Recognition on our supporter wall'],
    badge: 'Pay it forward',
  },
];
---
<BaseLayout title="Memberships — Soil Detective" description="Memberships that support local soil intelligence and keep Soil Lab Sundays accessible.">
  <section class="container-x pt-20 pb-12">
    <p class="eyebrow mb-4">Memberships</p>
    <h1 class="text-5xl md:text-6xl max-w-3xl">
      Grow with us — <span class="italic text-moss-700">all year round.</span>
    </h1>
    <p class="mt-6 text-soil/75 max-w-prose leading-relaxed">
      Memberships keep Soil Lab Sundays running, fund scholarships for neighbors, and give you a steady relationship with your soil instead of a one-off test. Cancel anytime.
    </p>
  </section>

  <section class="container-x pb-16">
    <div class="grid md:grid-cols-3 gap-6">
      {tiers.map((t) => (
        <article class="rounded-2xl bg-cream-dark/30 border border-soil/10 p-8 flex flex-col">
          <span class="self-start text-[10px] uppercase tracking-[0.2em] text-clay-500 bg-clay-500/10 px-2.5 py-1 rounded-full">{t.badge}</span>
          <h2 class="mt-5 text-2xl uppercase tracking-wide">{t.name}</h2>
          <div class="mt-3">
            <span class="font-display text-4xl text-soil">{t.price}</span>
            <span class="text-soil/60 text-sm"> / {t.sub}</span>
          </div>
          <p class="mt-4 text-soil/75 text-sm leading-relaxed">{t.body}</p>
          <ul class="mt-6 space-y-2.5 text-sm text-soil/80 flex-1">
            {t.perks.map((p) => (
              <li class="flex gap-2 items-start"><span class="mt-2 size-1.5 rounded-full bg-moss-600 shrink-0"></span><span>{p}</span></li>
            ))}
          </ul>
          <a href={link('/contact')} class="btn-moss mt-7">Become a Member</a>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-soil-700 text-cream">
    <div class="container-x py-20 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-500 mb-3">Why membership?</p>
        <h2 class="text-4xl md:text-5xl text-cream">Soil health is slow work. Steady support keeps it possible.</h2>
        <p class="mt-5 text-cream/85 max-w-prose leading-relaxed">
          Equipment, glassware, supplies, scholarship Soil Checks, and the unpaid time it takes to actually teach this — your membership funds the parts of this work that don't pay for themselves.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={link('/contact')} class="btn-gold">Talk to Us First</a>
        <a href={link('/support')} class="btn-outline-cream">One-time Support</a>
      </div>
    </div>
  </section>
</BaseLayout>
