---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const tools = [
  {
    title: 'Recipe Builder',
    body: 'Pick your ingredients and quantities. Get a live carbon-to-nitrogen ratio, a balance gauge, and adjustments toward the 25–35:1 hot-composting sweet spot.',
    href: '/community/recipe-builder',
    icon: 'recipe',
    accent: 'bg-moss-700',
  },
  {
    title: 'Example Recipes',
    body: 'Field-tested 250-gallon hot pile recipes — by season, by what you have on hand, and by what you are growing.',
    href: '/community/recipes',
    icon: 'book',
    accent: 'bg-clay-500',
  },
  {
    title: '30-Day Pile Tracker',
    body: 'Journal your hot pile from day one. Log ingredients, daily temperatures, turns, moisture, and notes. Export as CSV when you are done.',
    href: '/community/pile-tracker',
    icon: 'thermometer',
    accent: 'bg-plum-700',
  },
  {
    title: 'Tool Barn',
    body: 'Members share gear with neighbors — chipper-shredders, soil thermometers, broadforks, microscopes. Borrow what you need; share what you have.',
    href: '/community/tool-barn',
    icon: 'tool',
    accent: 'bg-gold-600',
  },
];
---
<BaseLayout title="Community — Soil Detective" description="Free tools for building hot compost recipes, tracking pile progress, sharing gear, and learning together.">
  <section class="container-x pt-20 pb-12">
    <p class="eyebrow mb-4">Community</p>
    <h1 class="text-5xl md:text-6xl max-w-3xl">
      Tools we built so you can <span class="italic text-moss-700">do this together.</span>
    </h1>
    <p class="mt-6 text-soil/75 max-w-prose leading-relaxed">
      Free, no-login tools for hot composting. Build a recipe, track a pile, find a tool to borrow, and lean on neighbors who have done it before.
    </p>
  </section>

  <section class="container-x pb-16">
    <div class="grid md:grid-cols-2 gap-6">
      {tools.map((t) => (
        <a href={link(t.href)} class="group rounded-2xl bg-cream-dark/30 border border-soil/10 p-8 hover:border-soil/30 transition flex gap-6">
          <div class={`size-14 rounded-full ${t.accent} text-cream flex items-center justify-center shrink-0`}>
            {t.icon === 'recipe' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14v16H5z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>}
            {t.icon === 'book' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2zM8 7h8M8 11h8M8 15h6"/></svg>}
            {t.icon === 'thermometer' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="10" y="2" width="4" height="14" rx="2"/><circle cx="12" cy="19" r="3"/><path d="M12 16v3"/></svg>}
            {t.icon === 'tool' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.7 5.7L3 18l3 3 6-6a4 4 0 0 0 5.7-5.7l-2.5 2.5-2.5-2.5z"/></svg>}
          </div>
          <div>
            <h2 class="text-2xl uppercase tracking-wide group-hover:text-moss-700 transition">{t.title}</h2>
            <p class="mt-3 text-soil/75 leading-relaxed">{t.body}</p>
            <span class="mt-4 inline-block text-[11px] font-semibold uppercase tracking-[0.2em] text-clay-500 group-hover:text-clay-700">Open tool →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-soil-700 text-cream">
    <div class="container-x py-20 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-500 mb-3">Made for our community</p>
        <h2 class="text-4xl md:text-5xl text-cream">Built for the way real piles get built.</h2>
        <p class="mt-5 text-cream/85 max-w-prose leading-relaxed">
          These tools assume the standard 250-gallon (~1 yd³) hot pile — the smallest size that holds enough thermal mass to actually get hot. If you are running something different, the math still works; just scale your ingredient quantities up or down.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={link('/community/recipe-builder')} class="btn-gold">Start a Recipe</a>
        <a href={link('/community/pile-tracker')} class="btn-outline-cream">Track a Pile</a>
      </div>
    </div>
  </section>
</BaseLayout>
