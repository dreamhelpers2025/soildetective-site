---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const ways = [
  { title: 'One-time donation', body: 'Direct support for Soil Lab Sundays, scholarship Soil Checks, and free community workshops.', cta: 'Donate', href: '/contact' },
  { title: 'Sponsor a scholarship', body: 'Cover the cost of a $50 Soil Health Check for a neighbor who couldn\'t otherwise afford one.', cta: 'Sponsor a Check', href: '/contact' },
  { title: 'Donate supplies', body: 'Slides, cover slips, microscope tools, harvested raw materials — we\'ll put it to work right away.', cta: 'Email Us', href: 'mailto:soildetective@gmail.com' },
  { title: 'Spread the word', body: 'Share Soil Detective with a friend, a neighbor, or your local community garden. Most growth comes from word of mouth.', cta: 'Share', href: 'mailto:?subject=Check out Soil Detective&body=https://www.soildetective.org' },
];
---
<BaseLayout title="Support — Soil Detective" description="Donate, sponsor a scholarship Soil Check, or support local soil intelligence in Western Washington.">
  <section class="container-x pt-20 pb-12">
    <p class="eyebrow mb-4">Support the Mission</p>
    <h1 class="text-5xl md:text-6xl max-w-3xl">
      Your support <span class="italic text-moss-700">matters.</span>
    </h1>
    <p class="mt-6 text-soil/75 max-w-prose leading-relaxed">
      Soil Detective is a small business doing community-scale work. Every dollar, scholarship sponsorship, and donated supply keeps Soil Lab Sundays open and free for the people who need it.
    </p>
  </section>

  <section class="container-x pb-16">
    <div class="grid md:grid-cols-2 gap-6">
      {ways.map((w) => (
        <article class="rounded-2xl bg-cream-dark/30 border border-soil/10 p-8 flex flex-col">
          <h2 class="text-2xl uppercase tracking-wide">{w.title}</h2>
          <p class="mt-3 text-soil/75 leading-relaxed flex-1">{w.body}</p>
          <a href={link(w.href)} class="btn-moss mt-6 self-start">{w.cta}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-moss-800 text-cream">
    <div class="container-x py-20 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-500 mb-3">Mission</p>
        <h2 class="text-3xl md:text-4xl text-cream uppercase tracking-wide font-medium">
          Waste can become soil.<br/>
          Soil can become food.<br/>
          Food can become community.
        </h2>
        <p class="mt-6 text-cream/85 max-w-prose leading-relaxed">
          A multicultural, woman-owned, LGBTQ+ small business in Olympia, WA — building a regenerative local system that turns waste into living compost, living compost into healthy soil, and healthy soil into stronger local food systems.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={link('/contact')} class="btn-gold">Get in Touch</a>
        <a href={link('/memberships')} class="btn-outline-cream">Become a Member</a>
      </div>
    </div>
  </section>
</BaseLayout>
