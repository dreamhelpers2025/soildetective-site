---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (p: string) => `${base}${p}`;

const cdn = 'https://images.squarespace-cdn.com/content/v1/689393086346c340c753f950';
const scope = `${cdn}/03ce3214-9cd9-44dc-bbb6-a9f13e2adf9b/Scope+n+Monitor.jpg?format=1500w`;
const amoeba = `${cdn}/18134adc-1d95-4a9d-8040-760c25e2eddd/Sept+22+2025.Amoeba+n+cyst.jpg?format=1500w`;
const garden = `${cdn}/145735a9-0f67-4282-97dd-957d7db71867/20230508_121328.jpg?format=1500w`;
const hands = `${cdn}/5720fe20-8bd9-48de-9f3c-11b1998a4ea3/3_6.20.2025.jpg?format=1500w`;

const services = [
  { badge: 'Entry point', name: 'Soil Lab Sundays', price: '$45', sub: '15-min microscope session', image: scope, body: "Bring a soil sample and look at it together. A friendly first look at what's actually alive — perfect if you've never had your soil read biologically. Membership credit applies if you join after.", cta: 'Book a Sunday' },
  { badge: 'Most popular', name: 'Biological Soil Analysis', price: '$159', sub: 'professional report + interpretation', image: amoeba, body: 'A full quantification of bacteria, fungi, protozoa, and nematodes — with a written PDF report, side-by-side imagery, reference ranges for your crop, and a 30-minute interpretation call. Uploaded to your member dashboard.', cta: 'Order an Analysis' },
  { badge: 'Compare your soil', name: 'Comparison Mixed-Media Report', price: '+$39 add-on', sub: 'pairs with the analysis above', image: garden, body: 'Digital photos and short videos comparing your sample to a healthy reference food web. The fastest way to see what your soil is missing.', cta: 'Add to Analysis' },
];

const packages = [
  {
    name: 'Backyard Revival',
    price: '$399',
    sub: 'One-time package',
    body: 'For homeowners and gardeners trying to bring tired beds back to life. A complete reset — analyze, amend, follow up.',
    includes: ['Full Biological Soil Analysis', 'Tailored compost & amendment plan', '30-minute consultation', '30-day follow-up check-in'],
    cta: 'Start a Revival',
    accent: 'moss',
  },
  {
    name: 'Raised Bed Reset',
    price: '$199',
    sub: 'Fixed-price service',
    body: 'A focused package for raised-bed growers. Simple, surgical, fast. Best between growing seasons.',
    includes: ['Soil Health Check (microscope)', 'Bed-by-bed amendment guidance', '5 lbs Living Compost starter', 'Email follow-up after 14 days'],
    cta: 'Reset My Beds',
    accent: 'clay',
  },
  {
    name: 'Market Garden Audit',
    price: 'from $1,250',
    sub: 'Custom multi-visit engagement',
    body: 'For small farms, urban farms, and market gardens running on margin. We treat your operation as a system.',
    includes: ['Up to 6 analyses across the operation', 'Water retention & infiltration assessment', 'Crop-specific biology balancing', 'Quarterly compost strategy', 'Seasonal recommendations'],
    cta: 'Request a Quote',
    accent: 'gold',
  },
];

const accentMap = {
  moss: { badge: 'bg-moss-700/15 text-moss-700', btn: 'btn-moss' },
  clay: { badge: 'bg-clay-500/15 text-clay-700', btn: 'btn-clay' },
  gold: { badge: 'bg-gold-500/15 text-gold-700', btn: 'btn-gold' },
} as const;
---
<BaseLayout title="Soil Testing & Packages — Soil Detective" description="Biological soil analysis, productized packages, and recurring soil health memberships from Soil Detective in Olympia, WA.">
  <section class="container-x pt-20 pb-12">
    <p class="eyebrow mb-4">Soil Testing & Packages</p>
    <h1 class="text-5xl md:text-6xl max-w-3xl">
      Know your soil. <span class="italic text-moss-700">Grow your best.</span>
    </h1>
    <p class="mt-6 text-soil/75 max-w-prose leading-relaxed">
      A chemical test tells you what's there. A biological test tells you what's working. We pair microscope-based assessment with personalized guidance — distinct from a chemical-only lab, and rooted in your local conditions.
    </p>
  </section>

  <!-- À la carte services -->
  <section class="container-x pb-8">
    <div class="flex items-baseline justify-between flex-wrap gap-3 mb-6">
      <h2 class="font-display text-2xl uppercase tracking-wide">À la carte services</h2>
      <span class="text-[11px] uppercase tracking-[0.2em] text-soil/50">Start here · pay as you go</span>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {services.map((s) => (
        <article class="rounded-xl bg-cream-dark/30 border border-soil/10 overflow-hidden flex flex-col">
          <div class="aspect-[16/10] overflow-hidden bg-soil-700">
            <img src={s.image} alt={s.name} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="p-6 flex flex-col flex-1">
            <span class="self-start text-[10px] uppercase tracking-[0.2em] text-clay-500 bg-clay-500/10 px-2.5 py-1 rounded-full">{s.badge}</span>
            <h3 class="mt-4 text-xl uppercase tracking-wide">{s.name}</h3>
            <div class="mt-2">
              <span class="font-display text-3xl text-soil">{s.price}</span>
              <span class="text-soil/60 text-sm"> · {s.sub}</span>
            </div>
            <p class="mt-4 text-soil/75 text-sm leading-relaxed flex-1">{s.body}</p>
            <a href={link('/contact')} class="mt-6 text-[11px] font-semibold uppercase tracking-[0.2em] text-clay-500 hover:text-clay-700">{s.cta} →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Productized packages -->
  <section class="bg-cream-dark/30 border-y border-soil/5 mt-12">
    <div class="container-x py-20">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow-moss mb-3">Outcome packages</p>
        <h2 class="text-4xl md:text-5xl">Buy the result, not the test.</h2>
        <p class="mt-5 text-soil/75 leading-relaxed">
          When you need a clear before-and-after, not a stack of data points. Each package bundles testing, amendments, and follow-up into one fixed price.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {packages.map((p) => (
          <article class={`rounded-2xl bg-cream border border-soil/10 p-7 flex flex-col`}>
            <span class={`self-start text-[10px] uppercase tracking-[0.2em] px-2.5 py-1 rounded-full ${accentMap[p.accent].badge}`}>{p.sub}</span>
            <h3 class="mt-4 text-2xl uppercase tracking-wide">{p.name}</h3>
            <div class="mt-2">
              <span class="font-display text-4xl text-soil">{p.price}</span>
            </div>
            <p class="mt-3 text-soil/75 text-sm leading-relaxed">{p.body}</p>
            <ul class="mt-5 space-y-2 text-sm text-soil/80 flex-1">
              {p.includes.map((it) => (
                <li class="flex gap-2 items-start"><span class="mt-2 size-1.5 rounded-full bg-moss-600 shrink-0"></span><span>{it}</span></li>
              ))}
            </ul>
            <a href={link('/contact')} class={`${accentMap[p.accent].btn} mt-6 w-full text-center`}>{p.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Annual / membership upsell -->
  <section class="container-x py-20">
    <div class="rounded-2xl bg-plum-700 text-cream p-10 md:p-14 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-500 mb-3">Recurring · Best value</p>
        <h2 class="text-3xl md:text-4xl text-cream">Annual Soil Health Membership</h2>
        <p class="mt-4 text-cream/85 max-w-prose">
          Most soils tell a different story every season. The membership covers <strong>4 quarterly Biological Soil Analyses</strong>, a member dashboard that tracks your progression over time, a private community, and discounts on compost and workshops. Less than buying analyses one at a time.
        </p>
      </div>
      <div class="flex flex-col gap-3 md:items-end">
        <a href={link('/memberships')} class="btn-gold">View Membership Tiers</a>
        <a href={link('/contact')} class="btn-outline-cream">Talk to Us First</a>
      </div>
    </div>
  </section>

  <!-- Why biology -->
  <section class="bg-cream-dark/30 border-y border-soil/5">
    <div class="container-x py-20 grid md:grid-cols-2 gap-12 items-start">
      <div>
        <p class="eyebrow-moss mb-4">Why biology</p>
        <h2 class="text-4xl md:text-5xl">The microbes are doing the work.</h2>
        <p class="mt-5 text-soil/80 leading-relaxed max-w-prose">
          Most labs measure nutrient stockpiles. We look through a microscope at the organisms that make those nutrients plant-available — and at the structure they're building. That's what regenerative growing actually depends on.
        </p>
      </div>
      <ul class="space-y-4 text-soil">
        <li class="flex gap-4 items-start"><span class="mt-2 size-2 rounded-full bg-moss-600"></span><span><strong>Personalized.</strong> Reference targets are tied to the crop or plant you intend to grow.</span></li>
        <li class="flex gap-4 items-start"><span class="mt-2 size-2 rounded-full bg-moss-600"></span><span><strong>Local.</strong> Calibrated to Western Washington soils and seasons.</span></li>
        <li class="flex gap-4 items-start"><span class="mt-2 size-2 rounded-full bg-moss-600"></span><span><strong>Actionable.</strong> Every report comes with a conversation — compost, cover crops, irrigation, or leaving well enough alone.</span></li>
        <li class="flex gap-4 items-start"><span class="mt-2 size-2 rounded-full bg-moss-600"></span><span><strong>Accessible.</strong> Scholarships available for Soil Lab Sundays — just ask.</span></li>
      </ul>
    </div>
  </section>
</BaseLayout>
