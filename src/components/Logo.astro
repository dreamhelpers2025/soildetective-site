---
interface Props {
  variant?: 'dark' | 'cream';
  size?: 'sm' | 'md' | 'lg';
}
const { variant = 'dark', size = 'md' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const heights = { sm: 'h-9', md: 'h-12', lg: 'h-16' };
const h = heights[size];

const cream = variant === 'cream';
const stroke = cream ? '#F4F1EA' : '#2B1E17';
const glassSize = { sm: 28, md: 34, lg: 44 }[size];
const wordSize = { sm: 'text-base', md: 'text-lg', lg: 'text-2xl' }[size];
---
{cream ? (
  <span class="inline-flex items-center gap-2 font-display text-cream">
    <svg width={glassSize} height={glassSize} viewBox="0 0 48 48" fill="none" aria-hidden="true">
      <circle cx="20" cy="20" r="13" stroke={stroke} stroke-width="2.5" />
      <circle cx="20" cy="20" r="9" stroke={stroke} stroke-width="1" stroke-dasharray="2 2" opacity="0.5" />
      <line x1="30" y1="30" x2="42" y2="42" stroke={stroke} stroke-width="3.5" stroke-linecap="round" />
      <circle cx="16" cy="17" r="1.5" fill={stroke} opacity="0.7" />
      <circle cx="23" cy="22" r="1.2" fill={stroke} opacity="0.5" />
      <circle cx="20" cy="14" r="0.9" fill={stroke} opacity="0.6" />
    </svg>
    <span class="leading-tight">
      <span class={`block font-bold tracking-[0.02em] ${wordSize}`}>SOIL</span>
      <span class={`block font-medium tracking-[0.32em] text-[0.6em] -mt-0.5 opacity-90`}>DETECTIVE</span>
    </span>
  </span>
) : (
  <img
    src={`${base}/logo.png`}
    alt="Soil Detective — Healthy soil. Healthy community."
    class={`${h} w-auto block`}
    width="1782"
    height="864"
  />
)}
